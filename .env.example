# TenderIQ configuration.
#
# Copy to .env and fill in the real values:  cp .env.example .env
#
# src/configs/variables.config.js validates this at boot and refuses to start on
# a missing required key. docker-compose.yml reads this same file, so the
# container credentials stay in sync with what the app loads.

NODE_ENV=development

# ---- Server -----------------------------------------------------------------
PORT=5000
LOG_LEVEL=info
CORS=http://localhost:3000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

ADMIN_PASSWORD=

# ---- PostgreSQL -------------------------------------------------------------
# PSQL_SSL accepts a boolean or Postgres sslmode vocabulary
# (require | prefer | verify-ca | verify-full) — set `require` for Neon/RDS,
# `disable` for a local container.
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_USER=postgres
PSQL_PASSWORD=postgres
PSQL_DATABASE=tenderiq
PSQL_SSL=disable

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ---- Object storage ---------------------------------------------------------
# STORAGE_DRIVER: s3 | local
# S3_SSE: AES256 | aws:kms | none  — MinIO needs `none` unless KMS is set up.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tenderiq
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SSE=none
STORAGE_LOCAL_ROOT=./.storage

# ---- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_ACTIVE_TIME=15m
REFRESH_TOKEN_ACTIVE_TIME=20d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALLBACK_URL=

# ---- Mail -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---- Scraper ----------------------------------------------------------------
# EXTRA_CA_DIR: gnumner.minfin.am omits its intermediate certificate, so the PEM
# in ./certs is required — without it every fetch fails TLS verification.
# MAX_LISTING_PAGES is a safety ceiling, not the depth control; lookbackHours in
# sources.config.js is what bounds a sweep.
SCRAPER_USER_AGENT=TenderIQBot/1.0 (+https://tenderiq.am/bot; contact@tenderiq.am)
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_EXTRA_CA_DIR=./certs
SCRAPER_HTTP_TIMEOUT_MS=30000
SCRAPER_BROWSER_TIMEOUT_MS=60000
SCRAPER_MAX_ATTEMPTS=5
SCRAPER_BACKOFF_BASE_MS=2000
SCRAPER_BACKOFF_MAX_MS=120000
SCRAPER_MAX_LISTING_PAGES=200
SCRAPER_MAX_DOCUMENT_BYTES=62914560
SCRAPER_FRESHNESS_SLA_MINUTES=15

# ---- Sources ----------------------------------------------------------------
SOURCE_ARMEPS_BASE=https://gnumner.minfin.am
SOURCE_ARMEPS_DETAIL_BASE=https://armeps.am
SOURCE_ARMEPS_CRON=*/5 * * * *
SOURCE_PPCM_BASE=https://gnumner.minfin.am
SOURCE_PPCM_CRON=0 3 * * *
